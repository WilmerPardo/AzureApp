# Variables de entorno para TaskFlow SaaS
# Copia este archivo como .env y rellena los valores reales

# Clave secreta para Flask (sesiones, CSRF). Cambia este valor en producción.
SECRET_KEY=change-this-secret-key-to-something-random-and-long

# Cadena de conexión a MySQL
# Formato: mysql+pymysql://usuario:password@host:puerto/nombre_db?charset=utf8mb4
DATABASE_URL=mysql+pymysql://usuario:password@localhost:3306/taskflowdb?charset=utf8mb4

# Para Azure Database for MySQL (Flexible Server), usar algo como:
# DATABASE_URL=mysql+pymysql://adminuser:Password123@miservidor.mysql.database.azure.com:3306/taskflowdb?charset=utf8mb4
# Si tu servidor exige TLS validado, define la ruta del certificado CA:
# MYSQL_SSL_CA=/home/site/wwwroot/DigiCertGlobalRootCA.crt.pem
