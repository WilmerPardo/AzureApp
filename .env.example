# Variables de entorno para TaskFlow SaaS
# Copia este archivo como .env y rellena los valores reales

# Clave secreta para Flask (sesiones, CSRF). Cambia este valor en producción.
SECRET_KEY=change-this-secret-key-to-something-random-and-long

# Cadena de conexión a PostgreSQL
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://usuario:password@localhost:5432/taskflowdb

# Para Azure PostgreSQL (Flexible Server), usar algo como:
# DATABASE_URL=postgresql://adminuser:Password123@miservidor.postgres.database.azure.com:5432/taskflowdb?sslmode=require
