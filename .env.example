# Variables de entorno para TaskFlow SaaS
# Copia este archivo como .env solo en desarrollo local.

# Clave secreta para Flask (sesiones, CSRF). Cambia este valor en produccion.
SECRET_KEY=change-this-secret-key-to-something-random-and-long

# Azure Cosmos DB for NoSQL.
# No guardes claves reales en el repositorio.
COSMOS_ENDPOINT=https://NOMBRE.documents.azure.com:443/
COSMOS_KEY=clave_primaria_o_secundaria
COSMOS_DATABASE_NAME=taskflowdb
COSMOS_USERS_CONTAINER=users
COSMOS_TASKS_CONTAINER=tasks

# PostHog analytics
POSTHOG_API_KEY=phc_your_project_token_here
POSTHOG_HOST=https://us.i.posthog.com

# Solo para migrar datos antiguos desde SQLite.
# SQLITE_DB_PATH=instance/taskflow.db
