# Variables de entorno para TaskFlow SaaS
# Copia este archivo como .env si quieres personalizar valores en desarrollo local.

# Clave secreta para Flask (sesiones, CSRF). Cambia este valor en produccion.
SECRET_KEY=change-this-secret-key-to-something-random-and-long

# SQLite es la base de datos por defecto.
# Local: instance/taskflow.db
# Azure App Service: /home/site/data/taskflow.db

# Opcional: usar una ruta SQLite personalizada.
# SQLITE_DB_PATH=instance/taskflow.db

# Opcional: solo si en el futuro quieres volver a usar otra base compatible
# con SQLAlchemy. Debes activar USE_DATABASE_URL para reemplazar SQLite.
# USE_DATABASE_URL=true
# DATABASE_URL=sqlite:///instance/taskflow.db
