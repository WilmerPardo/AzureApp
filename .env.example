# Variables de entorno para TaskFlow SaaS
# Copia este archivo como .env solo en desarrollo local.

# Clave secreta para Flask (sesiones, CSRF). Cambia este valor en produccion.
SECRET_KEY=change-this-secret-key-to-something-random-and-long

# Desarrollo local con SQLite.
SQLITE_DB_PATH=instance/taskflow.db

# Produccion con PostgreSQL usando una URL SQLAlchemy.
# DATABASE_URL tiene prioridad sobre cualquier otra variable de base de datos.
# DATABASE_URL=postgresql+psycopg2://usuario:password@servidor.postgres.database.azure.com:5432/taskflowdb?sslmode=require

# Produccion con variables generadas/configuradas en Azure App Service.
# Se usan solo si DATABASE_URL no existe.
# AZURE_POSTGRESQL_USER=usuario
# AZURE_POSTGRESQL_PASSWORD=password
# AZURE_POSTGRESQL_HOST=servidor.postgres.database.azure.com
# AZURE_POSTGRESQL_NAME=taskflowdb
